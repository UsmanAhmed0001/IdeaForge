# Required
YOUTUBE_API_KEY=
OPENROUTER_API_KEY=

# Model used for every draft. Pin one; falls back to openrouter/free if it errors.
# google/gemini-2.5-flash is cheap and reliable at structured output.
AI_MODEL=google/gemini-2.5-flash

# News (optional, tried in this order; Google News RSS is used if neither is set)
# GNews free tier allows production use: https://gnews.io
GNEWS_API_KEY=
# NewsAPI's free plan is for development only
NEWSAPI_KEY=

# Reddit (optional but recommended): create a "script" app at https://www.reddit.com/prefs/apps
# Without these, Reddit threads come from Google News and have no subreddit or comment counts.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Public URL, used for social previews and the OpenRouter referer
SITE_URL=https://idea-forge-liart.vercel.app