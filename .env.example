# Required
YOUTUBE_API_KEY=
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: model name. Defaults to gemini-3.5-flash, falls back to gemini-3.5-flash-lite.
AI_MODEL=

# Optional: image model for thumbnails (about $0.034 each). Falls back to gemini-nano-banana-2.1.
IMAGE_MODEL=

# Added automatically by Vercel when you connect a Blob store (Storage tab).
# Stores generated thumbnails and each channel's daily brief so they're never paid for twice.
BLOB_READ_WRITE_TOKEN=

# Optional alternative to Gemini. Only used when GEMINI_API_KEY is empty.
OPENROUTER_API_KEY=

# News (optional, tried in this order; Google News RSS is used if neither is set)
# GNews free tier allows production use: https://gnews.io
GNEWS_API_KEY=
# NewsAPI's free plan is for development only
NEWSAPI_KEY=

# Reddit (optional). Since Nov 2025 Reddit only issues API keys after manual approval,
# so leave these blank unless you already have an approved app. Without them,
# Reddit threads are found through Google News instead.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Public URL, used for social previews and the OpenRouter referer
SITE_URL=https://idea-forge-liart.vercel.app